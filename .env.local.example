# ---- public (shipped to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://ztxfcgygrnvwymyzcgyb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---- server only (never prefixed NEXT_PUBLIC_) ----
# Supabase → Project Settings → API Keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=
# platform.openai.com → API keys. All users' recordings are graded on this key.
OPENAI_API_KEY=sk-...
# Stripe → Developers → API keys. Use sk_test_ until you go live.
STRIPE_SECRET_KEY=sk_test_...
# From `node scripts/stripe-setup.mjs`
STRIPE_PRICE_ID=price_...
# From the webhook endpoint you create at Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to 0 if Stripe Tax is not enabled on your Stripe account
STRIPE_TAX=1
